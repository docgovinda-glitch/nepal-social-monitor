# Application Password Protection
APP_PASSWORD=PIC@55

# Supabase credentials (required for 24/7 news storage & reading)
SUPABASE_MANAGEMENT_TOKEN=your_supabase_management_token_here
SUPABASE_PROJECT_REF=your_supabase_project_ref_here

# NLP & Translation Fallback Settings
ENABLE_LOCAL_TRANSLATION_FALLBACK=true
TRANSLATION_PRIMARY=google
# Local MT Engine: "indictrans2" (default) or "nllb" (automatic secondary fallback)
LOCAL_MT_ENGINE=indictrans2
INDICTRANS2_MODEL_ID=adalat-ai/ct2-rotary-indictrans2-indic-en-dist-200M
# Optional Hugging Face token (required only if using gated ai4bharat/indictrans2-* repos)
HF_TOKEN=
TRANSLATION_CACHE_MAX_SIZE=5000
TRANSLATION_CIRCUIT_BREAKER_THRESHOLD=3
TRANSLATION_CIRCUIT_COOLDOWN_SECS=600

# Green API WhatsApp Integration Settings
GREEN_API_URL=https://7105.api.greenapi.com
GREEN_API_ID_INSTANCE=your_green_api_id_instance_here
GREEN_API_TOKEN_INSTANCE=your_green_api_token_instance_here
GREEN_API_CHAT_ID=120363428884458826@g.us
GREEN_API_SENDING_ENABLED=false
